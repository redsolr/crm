{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    // Generated openapi-fetch code uses runtime patterns that are valid
    // but trigger noisy diagnostics on the strict main config — relax
    // here, since we're only proving end-to-end import + signature
    // consistency, not enforcing platform code-style on the generator's
    // output.
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.generated.tsbuildinfo"
  },
  "include": [
    "src/lib/generated/api/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
