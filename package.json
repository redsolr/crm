{
  "name": "crm-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-dev-port.mjs",
    "dev": "next dev --turbopack --port 3100",
    "predev:mock": "node scripts/ensure-dev-port.mjs",
    "dev:mock": "cross-env MOCK_AUTH=true next dev --turbopack --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint src --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --concurrency=auto",
    "lint:fix": "eslint src --fix --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content --concurrency=auto",
    "tsc:check": "tsc --noEmit",
    "prepare": "husky || true",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pretest:e2e": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e": "cross-env MOCK_AUTH=true playwright test --project=mocked",
    "pretest:e2e:integration": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e:integration": "cross-env MOCK_AUTH=true E2E_MODE=integration playwright test --project=integration",
    "pretest:e2e:paas": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e:paas": "cross-env MOCK_AUTH=true E2E_MODE=integration E2E_PAAS=true playwright test --project=paas",
    "pretest:e2e:real-llm": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e:real-llm": "cross-env MOCK_AUTH=true E2E_MODE=integration RUN_REAL_LLM_E2E=true playwright test --project=integration chat-real-llm.integration.spec.ts",
    "pretest:e2e:mobile": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e:mobile": "cross-env MOCK_AUTH=true playwright test --project=mobile",
    "pretest:e2e:all": "node e2e/scripts/ensure-port-free.mjs",
    "test:e2e:all": "cross-env MOCK_AUTH=true playwright test",
    "test:e2e:ui": "cross-env MOCK_AUTH=true playwright test --ui",
    "test:e2e:debug": "cross-env MOCK_AUTH=true playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "openapi:sync": "node ./openapi/sync.mjs",
    "openapi:clean": "node -e \"require('node:fs').rmSync('src/lib/generated/api', { recursive: true, force: true })\"",
    "openapi:gen": "openapi-generator-cli generate -i openapi/openapi.yaml -g typescript-fetch -o src/lib/generated/api --additional-properties=supportsES6=true,modelPropertyNaming=original,enumPropertyNaming=original,withoutRuntimeChecks=true",
    "openapi:check": "tsc --noEmit -p tsconfig.generated.json",
    "openapi": "npm run openapi:sync && npm run openapi:clean && npm run openapi:gen && npm run openapi:check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@floating-ui/react": "^0.27.19",
    "@grafana/faro-web-sdk": "^2.3.1",
    "@grafana/faro-web-tracing": "^2.3.1",
    "@hocuspocus/provider": "^3.4.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@react-sigma/core": "^5.0.6",
    "@react-sigma/layout-forceatlas2": "^5.0.6",
    "@sentry/nextjs": "^10.47.0",
    "@serwist/next": "^9.5.7",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-border": "^3.0.0",
    "@stripe/stripe-js": "^8.11.0",
    "@tanstack/react-query": "^5.91.2",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tiptap/core": "^3.26.1",
    "@tiptap/extension-code-block-lowlight": "^3.26.1",
    "@tiptap/extension-collaboration": "^3.26.1",
    "@tiptap/extension-collaboration-caret": "^3.26.1",
    "@tiptap/extension-highlight": "^3.26.1",
    "@tiptap/extension-horizontal-rule": "^3.26.1",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-list": "^3.26.1",
