# crm — standalone internal CRM (ADR-001: platform docs adr-001-crm-internal-product-2026-07-13.md)
# Copy to .env.local and fill in. The app loads only .env.local.
# For UI work without auth/backend, skip all of this and run `npm run dev:mock`.

# Backend = this app's own /v1 route handlers (backend swap complete).
# Local dev points at itself; prod is https://crm.jurisimus.com.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3100

# CRM's own Postgres. `npm run docker:up` starts it; the default matches
# docker-compose.yml, so set this only for a non-default database.
# Prod (Vercel env var, never in a file): pooled Neon URL at runtime,
# direct URL passed inline for `drizzle-kit migrate`.
# DATABASE_URL=postgresql://crm:crm@localhost:5440/crm

# WorkOS AuthKit — the CRM's OWN WorkOS app (per-product app doctrine),
# NOT web-app's sandbox. Register http://localhost:3100/callback (dev)
# and https://crm.jurisimus.com/callback (prod — never a vercel.app URL)
# as redirect URIs in that app. WORKOS_COOKIE_NAME is per-app so sibling
# localhost apps can't clobber each other's `wos-session` cookie (see
# memory reference_localhost_workos_cookie_collision).
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_COOKIE_NAME=crm-wos-session
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3100/callback

# This app's own URL (metadata + absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# MCP endpoint bearer token — agent access (Claude Code, Claude Desktop,
# Cursor, …) to the 5 sales tools at `POST /mcp`. Any long random
# secret; the client sends `Authorization: Bearer <value>`. Unset =
# endpoint closed (401). Rotate by changing the value + redeploy.
# CRM_MCP_TOKEN=

# Anthropic — powers the Ask assistant + attribute enrichment (/compute).
# No fallback: Ask fails loudly without it. Optional CRM_ASK_MODEL
# overrides the default (claude-opus-5).
ANTHROPIC_API_KEY=
# CRM_ASK_MODEL=claude-opus-5

# Optional: PostHog (sales activation-ladder events no-op without it)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
