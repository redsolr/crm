# crm-web — internal CRM (ADR-001: platform docs adr-001-crm-internal-product-2026-07-13.md)
# Copy to .env.local and fill in. The app loads only .env.local.
# For UI work without auth/backend, skip all of this and run `npm run dev:mock`.

# Platform backend — still the live transport target until the backend
# swap completes; the in-repo /v1 route handlers take over at cutover
# (point this at http://localhost:3100 then).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# CRM's own Postgres (backend swap, strangler over the platform /v1
# surface). `npm run docker:up` starts it; the default matches
# docker-compose.yml, so set this only for a non-default database.
# DATABASE_URL=postgresql://crm:crm@localhost:5440/crm

# WorkOS AuthKit (same sandbox app as web-app). Register
# http://localhost:3100/callback as an additional redirect URI in the
# WorkOS dashboard, and keep NEXT_PUBLIC_WORKOS_REDIRECT_URI pointing at
# this app's port.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3100/callback

# This app's own URL (metadata + absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Optional: PostHog (sales activation-ladder events no-op without it)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
